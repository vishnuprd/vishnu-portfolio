# ------------------------------------------------------------------
#  Supabase — copy this file to `.env.local` and fill in your values.
#  Find these in Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------

# Project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "publishable" public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: restrict admin access to a single login email (recommended).
# ADMIN_EMAIL=you@example.com

# NOTE: No service_role / secret key is needed. Admin writes run as your
# logged-in session, enforced by Supabase Row Level Security. Just make sure
# to DISABLE public sign-ups in Supabase (Authentication → Sign In / Providers
# → turn off "Allow new users to sign up") so only your account can edit.
ADMIN_EMAIL=vishnuravichandran.28@gmail.com